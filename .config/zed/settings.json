// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_finder": {
    "include_ignored": "smart"
  },
  "git": {
    "git_gutter": "tracked_files",
    "file_diff": {
      
    },
    "inline_blame": {
      "show_commit_summary": false
    },
    "diff_base": "head",
    "hunk_style": "staged_hollow",
    "disable_git": false
  },
  "title_bar": {
    
  },
  "lsp_results_location": "picker",
  "diff_view_style": "split",
  "markdown_preview_font_size": 16.0,
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "agent_ui_font_family": "Fira Mono",
  "agent_buffer_font_family": "Fira Mono",
  "buffer_font_weight": 500.0,
  "markdown_preview_font_family": "Fira Mono",
  "markdown_preview_code_font_family": "Fira Mono",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "edit_predictions": {
    "ollama": {
      "api_url": "http://localhost:11434",
    },
    "mode": "subtle",
    "allow_data_collection": "no",
  },
  "cli_default_open_behavior": "new_window",
  "ui_font_weight": 500.0,
  "ui_font_family": "Fira Mono",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Fira Mono",
  "terminal": {
    "font_weight": 500.0,
    "font_family": "Fira Mono",
    "font_size": 16.0,
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/zsh",
        "args": ["--login"],
      },
    },
  },
  "disable_ai": false,
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Macchiato",
    "dark": "Material Icon Theme",
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "enabled",
  "git_panel": {
    "show_count_badge": false,
    "entry_primary_click_action": "file_diff",
    "group_by": "staging",
    "dock": "right",
    "file_icons": true,
    "tree_view": true,
  },
  "project_panel": {
    "git_status_indicator": true,
    "dock": "right",
  },
  "proxy": "",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "agent": {
    "single_file_review": true,
    "default_profile": "write",
    "sidebar_side": "left",
    "default_model": {
      "effort": "high",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
    },
    "dock": "left",
    "terminal_init_command": "",
    "favorite_models": [],
    "play_sound_when_agent_done": "when_hidden",
    "model_parameters": [],
  },
  "vim_mode": true,
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "effort": ["medium"],
      },
      "default_config_options": {
        "mode": "plan",
        "effort": "medium",
        "model": "ai-model-router/deepseek-ai/DeepSeek-V4-Pro-0813",
      },
      "type": "registry",
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": ["acceptEdits"],
      },
      "default_config_options": {
        "effort": "medium",
        "model": "default",
        "agent": "code-simplifier:code-simplifier",
        "mode": "auto",
      },
      "type": "registry",
    },
    "cursor": {
      "default_config_options": {
        "model": "grok-4.6",
      },
      "type": "registry",
    },
  },
  "base_keymap": "Zed",
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Duskfox - opaque",
  },
  "language_models": {
    "openai": {
      "api_url": "https://ai-model-router-api.eu.foundations.prod.int.hellofresh.io/v1",
      "available_models": [
        {
          "name": "claude-sonnet-5",
          "display_name": "Claude Sonnet 5 (via router)",
          "max_tokens": 16384,
        },
      ],
    },
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-ls"],
    },
    "TypeScript": {
      "language_servers": ["typescript-ls"],
    },
    "TSX": {
      "language_servers": ["typescript-ls"],
    },
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
}
